#!name=po0 直连 IP 加白
#!desc=定时/网络变化时，把本机 DIRECT 出口 IP 上报到 po0 白名单。请填写 po0 公网 IP、上报端口和 Token。
#!author=rollingshmily
#!homepage=https://github.com/rollingshmily/po0_whitelist
#!tag=po0,whitelist
#!loon_version=3.5.1(983)

[Argument]
host = input,"",tag=po0 地址,desc=po0 的公网 IP 或域名，不要带 http://
port = input,"41741",tag=上报端口,desc=默认 41741，需和 po0 上 p token 显示的端口一致
token = input,"",tag=上报 Token,desc=在 po0 上运行 p token 得到
notify = switch,true,tag=IP 变化时通知,desc=出口 IP 变化并上报成功后发本地通知

[Script]
cron "*/5 * * * *" then script("https://gh-proxy.com/https://raw.githubusercontent.com/rollingshmily/po0_whitelist/main/loon/po0-ip-report.js", {${host}, ${port}, ${token}, ${notify}}) with tag="po0直连IP定时上报", timeout=15
network-changed then script("https://gh-proxy.com/https://raw.githubusercontent.com/rollingshmily/po0_whitelist/main/loon/po0-ip-report.js", {${host}, ${port}, ${token}, ${notify}}) with tag="po0网络变化上报", timeout=15
generic then script("https://gh-proxy.com/https://raw.githubusercontent.com/rollingshmily/po0_whitelist/main/loon/po0-ip-report.js", {${host}, ${port}, ${token}, ${notify}}) with tag="po0手动上报", img_url="network", timeout=15
