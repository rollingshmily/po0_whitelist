#!name=po0 直连 IP 加白
#!desc=定时/网络变化时，把本机 DIRECT 出口 IP 上报到 po0 白名单。请填写 po0 公网 IP、上报端口和 Token。
#!author=rollingshmily
#!homepage=https://github.com/rollingshmily/po0_whitelist
#!date=2026-09-01 15:15 v1.13
#!tag=po0,whitelist
#!loon_version=3.5.1(983)

[Argument]
cron = input,"*/5 * * * *",tag=定时检查,desc=填 Cron。每5分钟：*/5 * * * *　每1分钟：*/1 * * * *
host = input,"",tag=信箱地址,desc=海外信箱机器的公网 IP 或域名，不要填国内防火墙机器
port = input,"18443",tag=信箱端口,desc=海外信箱监听端口，需和 mailbox-install.sh 一致
token = input,"",tag=上报 Token,desc=信箱安装时打印的 Token，和防火墙机器 p token 同一把
extra = input,"",tag=更多信箱,desc=可选。每行一台：地址|端口|Token
notify = switch,true,tag=IP 变化时通知,desc=出口 IP 变化并上报成功后发本地通知

[Script]
cron ${cron} then script("https://gh-proxy.com/https://raw.githubusercontent.com/rollingshmily/po0_whitelist/main/loon/po0-ip-report.js", {${cron}, ${host}, ${port}, ${token}, ${extra}, ${notify}}) with tag="po0直连IP定时上报", timeout=30
network-changed then script("https://gh-proxy.com/https://raw.githubusercontent.com/rollingshmily/po0_whitelist/main/loon/po0-ip-report.js", {${host}, ${port}, ${token}, ${extra}, ${notify}}) with tag="po0网络变化上报", timeout=30
generic then script("https://gh-proxy.com/https://raw.githubusercontent.com/rollingshmily/po0_whitelist/main/loon/po0-ip-report.js", {${host}, ${port}, ${token}, ${extra}, ${notify}}) with tag="po0手动上报", img_url="network", timeout=30
